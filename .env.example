# Copy this file to .env and fill in your values
# NEVER commit .env to git

# GitHub Personal Access Token
# Get one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos), public_repo (for public repos only)
GITHUB_TOKEN=your_github_token_here

# Anthropic API Key
# Get one at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB storage path (optional, defaults to ~/.chromax/db)
# CHROMAX_DB_PATH=~/.chromax/db

# Chromax session storage path (optional)
# CHROMAX_SESSIONS_PATH=~/.chromax/sessions

# LLM model to use (optional, defaults to claude-haiku-4-5-20251001)
# CHROMAX_MODEL=claude-haiku-4-5-20251001
